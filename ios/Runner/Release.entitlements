<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required by flutter_secure_storage so auth tokens persist across
	     launches. Keep in sync with Runner/DebugProfile.entitlements. -->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>